# tomcat.service - Tomcat 9 systemd unit（Type=forking + catalina.sh）
# 占位符：__CATALINA_HOME__ __JAVA_HOME__ __TOMCAT_USER__ __TOMCAT_GROUP__ __TOMCAT_APP_BASE__ __MYSQL_PORT__
# 说明：
# 1. Type=forking：catalina.sh start 会把 JVM 后台 fork，并把 PID 写入 CATALINA_PID
#    指向的文件，systemd 通过 PIDFile 跟踪真正的 Tomcat JVM 进程。
# 2. JVM 参数（-Xms/-Xmx/GC/编码等）统一放在 bin/setenv.sh，catalina.sh 启动时
#    自动 source，本文件不再重复维护一份 java 参数。

[Unit]
Description=Apache Tomcat 9 Web Server (deploy-bundle managed)
Documentation=https://tomcat.apache.org/tomcat-9.0-doc/
After=network.target mysqld.service
Wants=mysqld.service

[Service]
Type=forking
User=__TOMCAT_USER__
Group=__TOMCAT_GROUP__
PIDFile=__CATALINA_HOME__/temp/tomcat.pid

# === 关键环境变量 ===
# TimeoutStartSec 必须大于就绪门的 300s 超时上限：低配机器上 MySQL 首次初始化
# （建 ibdata/redo）可能超过 systemd 默认 90s，会被误杀（2026-11-13 Kylin V11 实测复现）
TimeoutStartSec=320
Environment=JAVA_HOME=__JAVA_HOME__
Environment=CATALINA_HOME=__CATALINA_HOME__
Environment=CATALINA_BASE=__CATALINA_HOME__
Environment=CATALINA_PID=__CATALINA_HOME__/temp/tomcat.pid
Environment=TOMCAT_HOME=__CATALINA_HOME__
Environment=JRE_HOME=__JAVA_HOME__/jre

ExecStartPre=/usr/bin/install -d -o __TOMCAT_USER__ -g __TOMCAT_GROUP__ -m 0755 \
    __CATALINA_HOME__/temp __CATALINA_HOME__/work __CATALINA_HOME__/logs __TOMCAT_APP_BASE__

# === MySQL 就绪门 ===
# mysqld 为 Type=simple，After=mysqld.service 仅保证启动顺序，
# 不保证 InnoDB 初始化完成、端口可连。此处阻塞等待 MySQL 端口就绪后再
# 拉起 Tomcat，避免应用因数据库未就绪而启动失败。
# 超时上限可通过 Environment=WAIT_FOR_MYSQL_TIMEOUT=<秒> 覆盖（默认 300s）
ExecStartPre=/bin/bash __CATALINA_HOME__/bin/wait-for-mysql.sh __MYSQL_PORT__

# catalina.sh start：后台 fork JVM → 写入 CATALINA_PID → 脚本退出
ExecStart=/bin/bash __CATALINA_HOME__/bin/catalina.sh start

# 优雅停机：tomcat-stop.sh 发送 SHUTDOWN 后最多等 60s（catalina.sh 硬编码只等 5s，
# 偏重的 Spring 应用停不干净会被过早 kill -9），超时兜底强杀
ExecStop=/bin/bash __CATALINA_HOME__/bin/tomcat-stop.sh
TimeoutStopSec=70
ExecStopPost=/usr/bin/rm -f __CATALINA_HOME__/temp/tomcat.pid

# === 重启策略 ===
Restart=on-failure
RestartSec=10

# === 资源限制 ===
LimitNOFILE=65535
LimitNPROC=65535

# === 安全 ===
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
# 应用部署目录（webapps 实际位置）必须显式放行，否则 unpackWARs 解包失败
ReadWritePaths=__CATALINA_HOME__/temp __CATALINA_HOME__/work __CATALINA_HOME__/logs __TOMCAT_APP_BASE__
PrivateTmp=false

[Install]
WantedBy=multi-user.target
