# my.cnf - MySQL 8.4 LTS 生产环境配置模板
# 关键设计点：
# 1. 内存参数按物理内存分档（install_mysql.sh 动态计算并 sed 替换占位符）
# 2. binlog 默认开启（ROW 格式），支持时间点恢复与后续主从扩展
# 3. redo 用 innodb_redo_log_capacity（8.0.30+ 新参数；innodb_log_file_size 已 deprecated）
# 4. skip-name-resolve: 离线环境无 DNS，避免 30s+ 启动延迟
# 5. default-time-zone: 国内业务统一 +08:00
# 6. character-set-server: utf8mb4
# 7. lower-case-table-names: 0（Linux 区分大小写）
# 8. bind-address=0.0.0.0 + root/admin@'%': 默认开放远程访问（用户约定）
# 占位符：__MYSQL_PORT__ __MYSQL_HOME__ __MYSQL_DATA_DIR__
#         __INNODB_BUFFER_POOL_SIZE__ __INNODB_REDO_LOG_CAPACITY__

[mysqld]
# === 基础 ===
user                                = mysql
port                                = __MYSQL_PORT__
# 远程访问已默认开启（0.0.0.0）；如仅需同机 Tomcat 直连，改回 127.0.0.1
bind-address                        = 0.0.0.0
basedir                             = __MYSQL_HOME__
datadir                             = __MYSQL_DATA_DIR__
socket                              = __MYSQL_DATA_DIR__/mysql.sock
pid-file                            = __MYSQL_DATA_DIR__/mysqld.pid
log-error                           = __MYSQL_DATA_DIR__/error.log
tmpdir                              = /tmp
server-id                           = 1
default_storage_engine              = InnoDB
# 远程访问提示：默认 bind-address=0.0.0.0 + root/admin@'%' 已开放外网访问。
# 如仅需同机 Tomcat 直连，改回 127.0.0.1 并去掉远程账号。

# === 字符集 ===
character-set-server                = utf8mb4
collation-server                    = utf8mb4_0900_ai_ci
# 注意：skip-character-set-client-handshake 在 MySQL 8.4 已被移除，不可配置

# === 时区（注意：等号赋值不带单引号） ===
default-time-zone                   = +08:00

# === 离线环境必须 ===
skip-name-resolve                   = ON

# === 认证插件（MySQL 8.4 适配） ===
# 8.4 起 mysql_native_password 插件默认禁用；install_mysql.sh 会创建
# mysql_native_password 认证的 admin 备用账号（兼容 Navicat 11 等老客户端），
# 必须在此显式启用，否则创建账号/登录会报 "Plugin ... is not enabled"
mysql_native_password               = ON

# === 大小写 ===
lower_case_table_names              = 0

# === 内存（install_mysql.sh 按物理内存分档替换） ===
innodb_buffer_pool_size             = __INNODB_BUFFER_POOL_SIZE__
innodb_redo_log_capacity            = __INNODB_REDO_LOG_CAPACITY__
innodb_log_buffer_size              = 64M
key_buffer_size                     = 32M

# === InnoDB IO / 刷盘 ===
innodb_flush_log_at_trx_commit      = 1
innodb_flush_method                 = O_DIRECT
innodb_file_per_table               = 1
innodb_io_capacity                  = 1000
innodb_io_capacity_max              = 2000
# 机械盘建议 flush_neighbors=1；SSD/云盘保持 0
innodb_flush_neighbors              = 0
innodb_read_io_threads              = 8
innodb_write_io_threads             = 8
innodb_purge_threads                = 4
innodb_print_all_deadlocks          = ON

# === 连接 ===
max_connections                     = 500
max_user_connections                = 480
back_log                            = 1500
max_connect_errors                  = 100000
connect_timeout                     = 10
wait_timeout                        = 28800
interactive_timeout                 = 28800
thread_cache_size                   = 64
table_open_cache                    = 4000
table_definition_cache              = 2000
open_files_limit                    = 65535
max_allowed_packet                  = 64M

# === 会话缓冲（每连接分配，勿盲目调大） ===
tmp_table_size                      = 64M
max_heap_table_size                 = 64M
sort_buffer_size                    = 2M
join_buffer_size                    = 2M
read_rnd_buffer_size                = 2M

# === binlog（生产必须：时间点恢复 / 主从扩展） ===
log-bin                             = __MYSQL_DATA_DIR__/mysql-bin
binlog_format                       = ROW
binlog_expire_logs_seconds          = 604800
max_binlog_size                     = 256M
sync_binlog                         = 1
binlog_cache_size                   = 1M
# 主从扩展时再启用 GTID（需全库统一规划，默认关闭）
# gtid_mode                         = ON
# enforce_gtid_consistency          = ON

# === 慢日志 ===
slow_query_log                      = ON
slow_query_log_file                 = __MYSQL_DATA_DIR__/slow.log
long_query_time                     = 2
log_queries_not_using_indexes       = ON
# 注意：log_throttle_queries_not_using_indexes 是 Percona 专属变量，社区版 MySQL 配置会报 unknown variable
min_examined_row_limit              = 100

# === sql_mode ===
sql_mode                            = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# === 安全 ===
local_infile                        = 0
secure_file_priv                    = NULL

# === performance_schema ===
performance_schema                  = ON
performance_schema_max_table_instances = 12500

[client]
port                                = __MYSQL_PORT__
socket                              = __MYSQL_DATA_DIR__/mysql.sock
default-character-set               = utf8mb4

[mysql]
default-character-set               = utf8mb4
# no-auto-rehash 是布尔 flag，不能写 "= 1"（mysql 客户端会报 cannot take an argument）
no-auto-rehash

[mysqldump]
default-character-set               = utf8mb4
quick
quote-names
max_allowed_packet                  = 64M
